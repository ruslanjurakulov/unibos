# npm run setup:local generates ignored .env (admin/migrations) and .env.runtime (runtime-only).
# This example contains no usable secrets. Production requires independent reviewed provisioning.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
OTEL_ENABLED=false
POSTGRES_USER=unibos
POSTGRES_DB=unibos
POSTGRES_PASSWORD=
REDIS_PASSWORD=
APP_DATABASE_PASSWORD=
AUTH_DATABASE_PASSWORD=
MIGRATION_DATABASE_URL=
DATABASE_URL=
AUTH_DATABASE_URL=
REDIS_URL=
AUTH_ENABLED=true
AUTH_ALLOW_SIGNUP=true
BETTER_AUTH_SECRET=
AUTH_BASE_URL=http://127.0.0.1:3001
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3001,http://127.0.0.1:3000
